  /******************************************************************
  アプリケーションのルートトップページ（/）を定義するコンポーネント
  ******************************************************************/

  // トップページアクセス時にウォッチリスト画面（/watchlist、260906仕様の新しい起点）へ即座にリダイレクトを実行
  redirect('/watchlist');
}
