# 日経225構成銘柄データについて

日経225の構成銘柄は日本経済新聞社が算出しており、機械可読な公式API/CSVは
提供されていません。以下の手順で手動データを用意し、取り込んでください。

## 手順

1. 「日経平均プロフィル」の構成銘柄一覧ページ
   （https://www.nikkei.com/marketdata/quote/NK225/constituents/）を開く
2. 掲載されている225銘柄の「証券コード」「銘柄名」「業種」を
   `nikkei225.template.csv` と同じフォーマット（`symbol,name,sector`）で
   CSVにまとめる（コピー＆ペースト → 表計算ソフトで整形 → CSV書き出し、が簡単）
3. できあがったCSVの中身を、管理画面の「日経225更新」フォームに貼り付けて送信
   （内部的には `POST /api/admin/import-nikkei225` に `{ csv: "<CSV文字列>" }` を送信）
4. 件数が225件でない場合は警告が返るので、入れ替え時期でないか・
   データの過不足がないか確認する

## 更新タイミング

日経225の定期入れ替えは例年4月・10月頃（臨時入れ替えが入ることもある）。
入れ替えが発表され、日経平均プロフィル側の情報が更新され次第、
同じ手順で再取り込みする（`replaceNikkei225` が既存データを洗い替える）。
</file>

<file path="public/workers/batchWorker.js">
// ウォッチリストのバッチ処理（最新シグナル取得 / Long Profit集計取得）進捗ポーリングを
// メインスレッドから切り離すためのWeb Worker。
// （既存 public/workers/screeningWorker.js と同一の考え方。タブが非アクティブでも
//  setInterval/setTimeoutのスロットリングを受けずに指定間隔通り処理を継続できる）
//
// メッセージプロトコル:
//   メイン -> Worker: { type: 'start', jobId: string, intervalMs: number }
//                      { type: 'stop' }
//   Worker -> メイン: { type: 'progress', payload: <BatchJob> }
//                      { type: 'error', message: string }

let timerId = null;
let currentJobId = null;
let isProcessing = false;

async function pollOnce(jobId) {
  if (isProcessing) return; // 前回の呼び出しが完了する前に多重発火しないようにする
  isProcessing = true;
  try {
    const res = await fetch('/api/batch/process', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ jobId }),
    });
    const data = await res.json();

    self.postMessage({ type: 'progress', payload: data.job });

    if (data.job && (data.job.status === 'COMPLETED' || data.job.status === 'FAILED')) {
      stopPolling();
    }
  } catch (err) {
    self.postMessage({ type: 'error', message: String(err) });
  } finally {
    isProcessing = false;
  }
}

function stopPolling() {
  if (timerId !== null) {
    clearInterval(timerId);
    timerId = null;
  }
  currentJobId = null;
}

self.onmessage = (event) => {
  const { type, jobId, intervalMs } = event.data || {};

  if (type === 'start') {
    stopPolling();
    currentJobId = jobId;
    // 即時に1回実行してから、以後は指定間隔で継続
    pollOnce(jobId);
    timerId = setInterval(() => {
      if (currentJobId) pollOnce(currentJobId);
    }, intervalMs || 1500);
  }

  if (type === 'stop') {
    stopPolling();
  }
};
</file>

<file path="public/workers/screeningWorker.js">
// スクリーニング実行の進捗ポーリングをメインスレッドから切り離すためのWeb Worker
//
// ブラウザのタブが非アクティブになると、メインスレッドの setInterval/setTimeout は
// 1秒間隔への制限やIntensive Throttlingの対象になるが、Web Worker内のタイマーは
// この制限を受けないため、タブを切り替えても指定間隔通りに処理を継続できる（H3の決定事項）。
//
// メッセージプロトコル:
//   メイン -> Worker: { type: 'start', runId: string, intervalMs: number }
//                      { type: 'stop' }
//   Worker -> メイン: { type: 'progress', payload: <APIレスポンスJSON> }
//                      { type: 'error', message: string }

let timerId = null;
let currentRunId = null;
let isProcessing = false;

async function pollOnce(runId) {
  if (isProcessing) return; // 前回の呼び出しが完了する前に多重発火しないようにする
  isProcessing = true;
  try {
    // まずPhase1のバッチ処理を試みる。Phase1が既に完了している場合は
    // process-phase1側が現在の状態をそのまま返すだけなので、
    // 状態を見てPhase2側を呼び分ける。
    let res = await fetch(`/api/screening/runs/${runId}/process-phase1`, {
      method: 'POST',
    });
    let data = await res.json();

    if (data.status === 'PHASE2_RUNNING' || data.status === 'COMPLETED') {
      res = await fetch(`/api/screening/runs/${runId}/process-phase2`, {
        method: 'POST',
      });
      data = await res.json();
    }

    self.postMessage({ type: 'progress', payload: data });

    if (data.status === 'COMPLETED' || data.status === 'FAILED') {
      stopPolling();
    }
  } catch (err) {
    self.postMessage({ type: 'error', message: String(err) });
  } finally {
    isProcessing = false;
  }
}

function stopPolling() {
  if (timerId !== null) {
    clearInterval(timerId);
    timerId = null;
  }
  currentRunId = null;
}

self.onmessage = (event) => {
  const { type, runId, intervalMs } = event.data || {};

  if (type === 'start') {
    stopPolling();
    currentRunId = runId;
    // 即時に1回実行してから、以後は指定間隔で継続
    pollOnce(runId);
    timerId = setInterval(() => {
      if (currentRunId) pollOnce(currentRunId);
    }, intervalMs || 2000);
  }

  if (type === 'stop') {
    stopPolling();
  }
};
</file>

