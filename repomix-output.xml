'use client';

import { useState, useEffect, useRef } from 'react';
import { MAX_DESIGNATED_SYMBOLS } from './constants';

interface Candidate {
  symbol: string; // "7203.T" 形式
  name: string;
}

interface DesignatedSymbol {
  symbol: string; // 4桁コード
  name: string;
}

interface Props {
  value: DesignatedSymbol[];
  onChange: (value: DesignatedSymbol[]) => void;
}

/******************************************************************
 指定銘柄の設定コンポーネント
 トリガー実行前にユーザーが最大20件まで銘柄を設定する（E4の決定事項）
 ******************************************************************/
export default function DesignatedSymbolsInput({ value, onChange }: Props) {
  const [query, setQuery] = useState('');
  const [candidates, setCandidates] = useState<Candidate[]>([]);
  const debounceRef = useRef<ReturnType<typeof setTimeout> | null>(null);

  useEffect(() => {
    if (debounceRef.current) clearTimeout(debounceRef.current);
    if (query.trim().length === 0) {
      setCandidates([]);
      return;
    }
    debounceRef.current = setTimeout(async () => {
      try {
        const res = await fetch(`/api/symbol-lookup?q=${encodeURIComponent(query)}`);
        const data = await res.json();
        // 東証銘柄（.T サフィックス）のみを候補として表示
        setCandidates((data.quotes || []).filter((q: Candidate) => q.symbol.endsWith('.T')));
      } catch {
        setCandidates([]);
      }
    }, 300);
    return () => {
      if (debounceRef.current) clearTimeout(debounceRef.current);
    };
  }, [query]);

  const addSymbol = (c: Candidate) => {
    const code4 = c.symbol.replace(/\.T$/, '');
    if (value.some((v) => v.symbol === code4)) return;
    if (value.length >= MAX_DESIGNATED_SYMBOLS) return;
    onChange([...value, { symbol: code4, name: c.name }]);
    setQuery('');
    setCandidates([]);
  };

  const removeSymbol = (code4: string) => {
    onChange(value.filter((v) => v.symbol !== code4));
  };

  return (
    <div>
      <div className="flex items-center justify-between mb-2">
        <h3 className="text-sm font-semibold text-gray-300">指定銘柄</h3>
        <span className="text-xs text-gray-500">
          {value.length} / {MAX_DESIGNATED_SYMBOLS}件
        </span>
      </div>

      <div className="relative max-w-sm">
        <input
          type="text"
          value={query}
          disabled={value.length >= MAX_DESIGNATED_SYMBOLS}
          onChange={(e) => setQuery(e.target.value)}
          placeholder={
            value.length >= MAX_DESIGNATED_SYMBOLS
              ? '上限に達しています'
              : '銘柄コード・銘柄名で検索'
          }
          className="w-full bg-gray-800 border border-gray-700 rounded-md px-3 py-2 text-sm text-gray-100 placeholder-gray-600 focus:outline-none focus:border-blue-500 disabled:opacity-50"
        />
        {candidates.length > 0 && (
          <ul className="absolute z-10 mt-1 w-full bg-gray-900 border border-gray-700 rounded-md shadow-lg max-h-56 overflow-y-auto">
            {candidates.map((c) => (
              <li key={c.symbol}>
                <button
                  type="button"
                  onClick={() => addSymbol(c)}
                  className="w-full text-left px-3 py-2 text-sm hover:bg-gray-800 flex justify-between gap-2"
                >
                  <span className="text-gray-100">{c.name}</span>
                  <span className="text-gray-500">{c.symbol}</span>
                </button>
              </li>
            ))}
          </ul>
        )}
      </div>

      {value.length > 0 && (
        <ul className="mt-3 flex flex-wrap gap-2">
          {value.map((v) => (
            <li
              key={v.symbol}
              className="flex items-center gap-1.5 bg-gray-800 border border-gray-700 rounded-full pl-3 pr-1.5 py-1 text-xs text-gray-200"
            >
              <span>
                {v.name} ({v.symbol})
              </span>
              <button
                type="button"
                onClick={() => removeSymbol(v.symbol)}
                className="w-4 h-4 flex items-center justify-center rounded-full hover:bg-gray-700 text-gray-400"
                aria-label={`${v.symbol}を削除`}
              >
                ×
              </button>
            </li>
          ))}
        </ul>
      )}
    </div>
  );
}
</file>

<file path="components/screening/FilterForm.tsx">
'use client';

import { RANGE_FILTER_FIELDS, TEXT_FILTER_FIELDS } from './constants';
import type { FilterCriteria } from '@/lib/screening/types';

interface Props {
  filters: FilterCriteria;
  onChange: (filters: FilterCriteria) => void;
  minTradeCount: number;
  onMinTradeCountChange: (value: number) => void;
}

/******************************************************************
 絞り込み条件入力フォーム
 A4: 全項目任意（未入力＝条件なし）。数値項目はmin/maxのレンジ入力。
 ******************************************************************/
export default function FilterForm({
  filters,
  onChange,
  minTradeCount,
  onMinTradeCountChange,
}: Props) {
  const updateRange = (
    key: (typeof RANGE_FILTER_FIELDS)[number]['key'],
    edge: 'min' | 'max',
    raw: string
  ) => {
    const value = raw.trim() === '' ? undefined : Number(raw);
    onChange({
      ...filters,
      [key]: {
        ...(filters[key] || {}),
        [edge]: Number.isFinite(value as number) ? value : undefined,
      },
    });
  };

  const updateText = (
    key: (typeof TEXT_FILTER_FIELDS)[number]['key'],
    raw: string
  ) => {
    onChange({ ...filters, [key]: raw.trim() === '' ? undefined : raw });
  };

  const groups = Array.from(new Set(RANGE_FILTER_FIELDS.map((f) => f.group)));

  return (
    <div className="space-y-6">
      {/* テキスト一致項目（企業基本情報の一部） */}
      <div>
        <h3 className="text-sm font-semibold text-gray-300 mb-2">企業基本情報</h3>
        <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
          {TEXT_FILTER_FIELDS.map((f) => (
            <div key={f.key}>
              <label className="block text-xs text-gray-400 mb-1">{f.label}</label>
              <input
                type="text"
                placeholder="未入力=条件なし"
                value={(filters[f.key] as string) ?? ''}
                onChange={(e) => updateText(f.key, e.target.value)}
                className="w-full bg-gray-800 border border-gray-700 rounded-md px-2 py-1.5 text-sm text-gray-100 placeholder-gray-600 focus:outline-none focus:border-blue-500"
              />
            </div>
          ))}
        </div>
      </div>

      {/* レンジ入力項目（グループごと） */}
      {groups.map((group) => (
        <div key={group}>
          <h3 className="text-sm font-semibold text-gray-300 mb-2">{group}</h3>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
            {RANGE_FILTER_FIELDS.filter((f) => f.group === group).map((f) => {
              const range = filters[f.key];
              return (
                <div key={f.key} className="bg-gray-900/50 border border-gray-800 rounded-md p-2.5">
                  <div className="flex items-center justify-between mb-1.5">
                    <span className="text-xs text-gray-300">{f.label}</span>
                    {f.hint && <span className="text-[10px] text-gray-500">{f.hint}</span>}
                  </div>
                  <div className="flex items-center gap-2">
                    <input
                      type="number"
                      placeholder="下限"
                      value={range?.min ?? ''}
                      onChange={(e) => updateRange(f.key, 'min', e.target.value)}
                      className="w-full bg-gray-800 border border-gray-700 rounded-md px-2 py-1 text-xs text-gray-100 placeholder-gray-600 focus:outline-none focus:border-blue-500"
                    />
                    <span className="text-gray-600 text-xs">〜</span>
                    <input
                      type="number"
                      placeholder="上限"
                      value={range?.max ?? ''}
                      onChange={(e) => updateRange(f.key, 'max', e.target.value)}
                      className="w-full bg-gray-800 border border-gray-700 rounded-md px-2 py-1 text-xs text-gray-100 placeholder-gray-600 focus:outline-none focus:border-blue-500"
                    />
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}

      {/* C3: 発生回数の最低閾値（初期値0=条件なし） */}
      <div>
        <h3 className="text-sm font-semibold text-gray-300 mb-2">Long Profit 発生回数の最低閾値</h3>
        <div className="flex items-center gap-2 max-w-xs">
          <input
            type="number"
            min={0}
            value={minTradeCount}
            onChange={(e) => onMinTradeCountChange(Math.max(0, Number(e.target.value) || 0))}
            className="w-24 bg-gray-800 border border-gray-700 rounded-md px-2 py-1.5 text-sm text-gray-100 focus:outline-none focus:border-blue-500"
          />
          <span className="text-xs text-gray-500">回以上（0=条件なし）</span>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="components/screening/ProgressPanel.tsx">
'use client';

interface Props {
  status: string;
  phase1Total: number;
  phase1Processed: number;
  phase2Total: number;
  phase2Processed: number;
  pollIntervalMs: number;
  skippedCount: number;
}

function formatEta(remaining: number, intervalMs: number): string {
  const totalSeconds = Math.ceil((remaining * intervalMs) / 1000);
  if (totalSeconds < 60) return `約${totalSeconds}秒`;
  const minutes = Math.floor(totalSeconds / 60);
  if (minutes < 60) return `約${minutes}分`;
  const hours = Math.floor(minutes / 60);
  const remMinutes = minutes % 60;
  return `約${hours}時間${remMinutes}分`;
}

/******************************************************************
 進捗表示パネル
 D2の決定事項: 簡易的でよい。動作中であることと簡易的な進捗が分かることを優先する。
 ******************************************************************/
export default function ProgressPanel({
  status,
  phase1Total,
  phase1Processed,
  phase2Total,
  phase2Processed,
  pollIntervalMs,
  skippedCount,
}: Props) {
  const isPhase1 = status === 'PHASE1_RUNNING';
  const isPhase2 = status === 'PHASE2_RUNNING';

  const processed = isPhase1 ? phase1Processed : phase2Processed;
  const total = isPhase1 ? phase1Total : phase2Total;
  const remaining = Math.max(0, total - processed);
  const percent = total > 0 ? Math.min(100, Math.round((processed / total) * 100)) : 0;

  return (
    <div className="bg-gray-900 border border-gray-800 rounded-xl p-6 space-y-4">
      <div className="flex items-center gap-3">
        <span className="inline-block w-5 h-5 border-2 border-blue-500 border-t-transparent rounded-full animate-spin" />
        <div>
          <p className="text-sm font-semibold text-gray-100">
            {isPhase1 ? '銘柄を調査中です（Phase1: 指標絞り込み）' : '銘柄を調査中です（Phase2: Long Profit集計）'}
          </p>
          <p className="text-xs text-gray-500 mt-0.5">画面を開いたままお待ちください</p>
        </div>
      </div>

      <div>
        <div className="flex justify-between text-xs text-gray-400 mb-1">
          <span>
            処理済み {processed} / {total} 銘柄
          </span>
          <span>{percent}%</span>
        </div>
        <div className="w-full h-2 bg-gray-800 rounded-full overflow-hidden">
          <div
            className="h-full bg-blue-500 transition-all duration-300"
            style={{ width: `${percent}%` }}
          />
        </div>
      </div>

      <div className="flex flex-wrap gap-x-6 gap-y-1 text-xs text-gray-500">
        <span>推定残り時間: {formatEta(remaining, pollIntervalMs)}</span>
        {skippedCount > 0 && <span className="text-amber-500">スキップ: {skippedCount}銘柄</span>}
        {isPhase1 && phase2Total === 0 && (
          <span>Phase1完了後、Phase2（Long Profit集計）の件数が確定します</span>
        )}
      </div>
    </div>
  );
}
