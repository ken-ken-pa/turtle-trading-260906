<file path="lib/nikkei225.ts">
/**
 * 日経225構成銘柄の手動管理ロジック（J2案1）
 *
 * 日経225の構成銘柄は日本経済新聞社が算出・公表しており、
 * 機械可読な公式API/CSVは提供されていないため、
 * 「日経平均プロフィル」の構成銘柄一覧ページから取得したデータを
 * CSVとして管理画面からアップロードし、DBへ反映する方式とする。
 *
 * 銘柄入れ替えは例年4月・10月の年2回程度のため、更新頻度は低くて済む。
 *
 * 期待するCSVフォーマット（ヘッダー行必須、カンマ区切り、UTF-8）:
 *   symbol,name,sector
 *   7203,トヨタ自動車,輸送用機器
 *   ...
 */

import { PrismaClient } from "@prisma/client";

export interface Nikkei225Row {
  symbol: string;
  name: string;
  sector: string | null;
}

export class Nikkei225ImportError extends Error {}

/**
 * アップロードされたCSVテキストをパースする。
 * 件数チェック（225件程度）は警告のみで、厳密には強制しない
 * （入れ替え直後で件数が前後する可能性を許容するため）。
 */
export function parseNikkei225Csv(csvText: string): Nikkei225Row[] {
  const lines = csvText
    .split(/\r?\n/)
    .map((l) => l.trim())
    .filter((l) => l.length > 0);

  if (lines.length === 0) {
    throw new Nikkei225ImportError("CSVが空です");
  }

  const header = lines[0].split(",").map((h) => h.trim());
  const symbolIdx = header.indexOf("symbol");
  const nameIdx = header.indexOf("name");
  const sectorIdx = header.indexOf("sector");

  if (symbolIdx === -1 || nameIdx === -1) {
    throw new Nikkei225ImportError(
      "CSVのヘッダーに symbol, name 列が必要です（例: symbol,name,sector）"
    );
  }

  const rows: Nikkei225Row[] = [];
  for (let i = 1; i < lines.length; i++) {
    const cols = lines[i].split(",");
    const rawSymbol = (cols[symbolIdx] ?? "").trim();
    const name = (cols[nameIdx] ?? "").trim();
    if (!rawSymbol || !name) continue;

    rows.push({
      symbol: rawSymbol.padStart(4, "0"),
      name,
      sector: sectorIdx !== -1 ? (cols[sectorIdx] ?? "").trim() || null : null,
    });
  }

  if (rows.length === 0) {
    throw new Nikkei225ImportError("有効なデータ行がありませんでした");
  }

  return rows;
}

export interface ImportNikkei225Result {
  parsedCount: number;
  upsertedCount: number;
  removedCount: number;
  warning: string | null;
}

/**
 * パース済みの日経225銘柄リストでDBを「完全に置き換える」。
 * 入れ替えのたびに銘柄が入れ替わるため、既存データを消して洗い替える方式が
 * 手動管理としては最もシンプルで事故が少ない。
 */
export async function replaceNikkei225(
  prisma: PrismaClient,
  rows: Nikkei225Row[]
): Promise<ImportNikkei225Result> {
  const result = await prisma.$transaction(async (tx) => {
    const before = await tx.nikkei225Constituent.count();

    await tx.nikkei225Constituent.deleteMany({});

    await tx.nikkei225Constituent.createMany({
      data: rows.map((r) => ({
        symbol: r.symbol,
        name: r.name,
        sector: r.sector,
      })),
    });

    return { before, after: rows.length };
  });

  const warning =
    rows.length !== 225
      ? `件数が225件ではありません（取込件数: ${rows.length}件）。入れ替え直後や誤ったファイルでないかご確認ください。`
      : null;

  return {
    parsedCount: rows.length,
    upsertedCount: result.after,
    removedCount: result.before,
    warning,
  };
}
</file>

<file path="lib/prisma.ts">
// PrismaClient クラスをインポート
import { PrismaClient } from '@prisma/client';
// Prisma 用の PostgreSQL アダプターをインポート
import { PrismaPg } from '@prisma/adapter-pg';
// pg ライブラリの Pool クラスをインポート
import { Pool } from 'pg';

// グローバル空間に prisma インスタンスを保持するための型拡張
const globalForPrisma = globalThis as unknown as {
  prisma: PrismaClient | undefined;
};

// 環境変数からデータベース接続文字列を取得
const connectionString = process.env.DATABASE_URL;

// PostgreSQL 接続プールを生成
const pool = new Pool({ connectionString });
// Prisma アダプターを生成
const adapter = new PrismaPg(pool);

// PrismaClient のシングルトンインスタンスを生成・エクスポート
export const prisma =
  globalForPrisma.prisma ||
  new PrismaClient({
    adapter,
    log: process.env.NODE_ENV === 'development' ? ['query', 'error', 'warn'] : ['error'],
  });

// 開発環境の場合はグローバル変数にインスタンスを保存し再利用
if (process.env.NODE_ENV !== 'production') globalForPrisma.prisma = prisma;
</file>

<file path="lib/registrationConfig.ts">
// 新規ユーザー登録の許可・不許可を判定する設定モジュール
//
// 環境変数 ALLOW_NEW_USER_REGISTRATION でON/OFFを切り替える。
// 未設定の場合はデフォルトで「許可」（既存の挙動を維持）。
// 'false' / '0' / 'no' / 'off'（大文字小文字問わず）のいずれかを設定すると新規登録を停止する。
//
// .env（デプロイ環境の環境変数）を変更するだけでコードの変更・再デプロイ無しに切り替え可能。
// サーバーサイド専用の環境変数のためNEXT_PUBLIC_プレフィックスは付けず、クライアント側へは
// 都度 GET /api/register を介して現在の状態を渡す（ビルド時に値が固定化されるのを防ぐため）。

/**
 * 新規ユーザー登録が現在許可されているかどうかを返す
 */
export function isNewUserRegistrationAllowed(): boolean {
  // 環境変数を取得（未設定時は許可扱いのデフォルト文字列を使用）
  const raw = (process.env.ALLOW_NEW_USER_REGISTRATION ?? 'true').trim().toLowerCase();
  // 明示的に無効を示す値の場合のみ不許可とする
  const disabledValues = ['false', '0', 'no', 'off'];
  return !disabledValues.includes(raw);
}

// 新規登録停止時にユーザーへ表示する共通メッセージ
export const NEW_USER_REGISTRATION_DISABLED_MESSAGE = '現在、新規ユーザー登録は停止しています。';
