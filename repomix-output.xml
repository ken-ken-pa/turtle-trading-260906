<file path="components/dashboard/DashboardMobileMenu.tsx">
// クライアントコンポーネントであることを宣言
'use client';

// Reactのステート・副作用フックをインポート（画面幅に応じた選択肢の絞り込みに使用）
import { useState, useEffect } from 'react';
// 定数定義をインポート
import { PERIOD_OPTIONS, SPLIT_COUNT_OPTIONS, INTERVAL_OPTIONS } from './constants';

// モバイル操作メニューのPropsインターフェース定義
// 260906仕様: 銘柄数・足種別・戦略設定の編集UIは廃止（すべて/watchlistで一元管理）。
// 画面分割・表示期間のみ編集可能、足種別・選択銘柄数は表示のみ。
export interface DashboardMobileMenuProps {
  // 画面分割（全画面/2分割/4分割）
  splitCount: number;
  // 画面分割変更コールバック
  onSplitCountChange: (count: number) => void;
  // 表示期間
  period: string;
  // 表示期間変更コールバック
  onPeriodChange: (period: string) => void;
  // 足種別（表示専用）
  interval: string;
  // ウォッチリストで現在チェック選択されている銘柄数（表示のみ）
  selectedCount: number;
}

/******************************************************************
 モバイル用ダッシュボード操作メニューコンポーネント
 モバイルドロワー内に表示する各種コントロール（画面数、期間）と
 足種別・選択銘柄数の表示を提供します
 ******************************************************************/
export default function DashboardMobileMenu({
  splitCount,
  onSplitCountChange,
  period,
  onPeriodChange,
  interval,
  selectedCount,
}: DashboardMobileMenuProps) {
  // 画面幅がTailwindの md ブレークポイント（768px）以上かどうかの管理ステート
  const [isMdOrWider, setIsMdOrWider] = useState(false);

  // 画面幅の変化を監視する副作用フック
  useEffect(() => {
    const mql = window.matchMedia('(min-width: 768px)');
    const update = () => setIsMdOrWider(mql.matches);
    update();
    mql.addEventListener('change', update);
    return () => mql.removeEventListener('change', update);
  }, []);

  // 現在の画面幅で選択可能な画面分割の選択肢（スマホ幅=全画面のみ／ノートパッド幅=全画面・2分割まで）
  const availableSplitOptions = SPLIT_COUNT_OPTIONS.filter((item) => (isMdOrWider ? item.val <= 2 : item.val === 1));

  const displaySplitCount = availableSplitOptions.some((item) => item.val === splitCount)
    ? splitCount
    : availableSplitOptions[availableSplitOptions.length - 1].val;

  const intervalLabel = INTERVAL_OPTIONS.find((o) => o.val === interval)?.label ?? interval;

  // モバイル用コントロール群のJSXを返却
  return (
    <>
      {/* 画面分割セクション */}
      <div className="space-y-2">
        <div className="text-[10px] font-bold text-slate-500 uppercase tracking-widest px-1">
          画面分割
        </div>
        <select
          value={displaySplitCount}
          onChange={(e) => onSplitCountChange(Number(e.target.value))}
          className="w-full px-3 py-2.5 rounded-lg bg-slate-900 border border-slate-700/80 text-sm font-bold text-slate-200 focus:outline-none focus:border-blue-500 transition"
        >
          {availableSplitOptions.map((item) => (
            <option key={item.val} value={item.val}>
              {item.label}
            </option>
          ))}
        </select>
      </div>

      {/* 表示銘柄数（表示のみ・変更はウォッチリスト画面で行う） */}
      <div className="space-y-2">
        <div className="text-[10px] font-bold text-slate-500 uppercase tracking-widest px-1">
          表示銘柄
        </div>
        <a
          href="/watchlist"
          className="block w-full px-3 py-2.5 rounded-lg bg-slate-900 border border-slate-700/80 text-sm font-bold text-blue-400 text-center"
        >
          {selectedCount}銘柄選択中（ウォッチリストで変更）
        </a>
      </div>

      {/* 期間セクション */}
      <div className="space-y-2">
        <div className="text-[10px] font-bold text-slate-500 uppercase tracking-widest px-1">
          期間
        </div>
        <div className="grid grid-cols-3 gap-1.5">
          {PERIOD_OPTIONS.map((item) => (
            <button
              key={item.val}
              onClick={() => onPeriodChange(item.val)}
              className={`py-2 rounded-lg text-xs font-bold transition ${
                period === item.val
                  ? 'bg-blue-600 text-white shadow'
                  : 'bg-slate-800 text-slate-400 hover:text-slate-200 hover:bg-slate-700'
              }`}
            >
              {item.label}
            </button>
          ))}
        </div>
      </div>

      {/* 足種別（表示専用。変更はウォッチリストの共通設定パネルで行う） */}
      <div className="space-y-2">
        <div className="text-[10px] font-bold text-slate-500 uppercase tracking-widest px-1">
          足（表示専用）
        </div>
        <div className="w-full px-3 py-2.5 rounded-lg bg-slate-800/80 border border-slate-700/60 text-sm font-bold text-slate-300 text-center">
          {intervalLabel}
        </div>
      </div>
    </>
  );
}
</file>

<file path="components/layout/MobileDrawer.tsx">
// クライアントコンポーネントであることを宣言
'use client';

// ReactからuseState・useEffect・useRef・ReactNodeをインポート
import { useState, useEffect, useRef } from 'react';
// ReactDOMのcreatePortalをインポート（body直下に描画してスタッキングコンテキスト問題を回避）
import { createPortal } from 'react-dom';

// MobileDrawerコンポーネントのPropsインターフェース定義
interface MobileDrawerProps {
  // ドロワーの内容（ReactNode）
  children: React.ReactNode;
}

// 汎用モバイルドロワーコンポーネント（ハンバーガーボタン＋スライドドロワー）
export default function MobileDrawer({ children }: MobileDrawerProps) {
  // ドロワー開閉状態
  const [isOpen, setIsOpen] = useState<boolean>(false);
  // SSR/クライアント初期化完了フラグ（createPortalはクライアントのみ使用可能）
  const [isMounted, setIsMounted] = useState<boolean>(false);
  // ドロワーパネルのDOM参照（将来の外側クリック検知拡張用）
  const drawerRef = useRef<HTMLDivElement>(null);

  // クライアントサイドでのみマウント完了フラグを立てる
  useEffect(() => {
    // マウント完了を記録（createPortal使用の前提条件）
    setIsMounted(true);
  }, []);

  // ESCキーでドロワーを閉じる処理
  useEffect(() => {
    // キーダウンイベントハンドラー
    const handleKeyDown = (e: KeyboardEvent) => {
      // ESCキーが押された場合に閉じる
      if (e.key === 'Escape') setIsOpen(false);
    };
    // イベントリスナーを登録
    document.addEventListener('keydown', handleKeyDown);
    // クリーンアップ時にリスナーを解除
    return () => document.removeEventListener('keydown', handleKeyDown);
  }, []);

  // ドロワーが開いている間はbodyのスクロールを無効化
  useEffect(() => {
    // 開状態でoverflow-hiddenを付与し、スクロールを防止
    document.body.style.overflow = isOpen ? 'hidden' : '';
    // クリーンアップ時にスタイルをリセット
    return () => { document.body.style.overflow = ''; };
  }, [isOpen]);

  // ドロワーのJSXを返却
  return (
    <>
      {/* ハンバーガーボタン（lg以上では非表示） */}
      <button
        type="button"
        aria-label="メニューを開く"
        aria-expanded={isOpen}
        onClick={() => setIsOpen(true)}
        className="lg:hidden flex flex-col justify-center items-center w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 transition gap-1.5"
      >
        {/* ハンバーガーアイコン上段 */}
        <span className="block w-5 h-0.5 bg-slate-300 rounded" />
        {/* ハンバーガーアイコン中段 */}
        <span className="block w-5 h-0.5 bg-slate-300 rounded" />
        {/* ハンバーガーアイコン下段 */}
        <span className="block w-5 h-0.5 bg-slate-300 rounded" />
      </button>

      {/* スライドアニメーション定義（常にDOMに存在させる） */}
      <style>{`
        @keyframes slideInFromRight {
          from { transform: translateX(100%); opacity: 0; }
          to   { transform: translateX(0);    opacity: 1; }
        }
      `}</style>

      {/*
        ドロワー本体をcreatePortalでdocument.body直下に描画する。
        理由：Navbarの backdrop-blur（backdrop-filter）がスタッキングコンテキストを
        生成するため、Navbar内部の fixed 要素がチャートより下に描画される問題が発生する。
        Portalで body 直下に出すことで、すべての親要素のスタッキングコンテキストを
        回避し、z-index が確実に最上位に適用される。
      */}
      {isMounted && isOpen && createPortal(
        <>
          {/* 背景オーバーレイ（クリックで閉じる） */}
          <div
            className="fixed inset-0 bg-black/60 z-[9998]"
            onClick={() => setIsOpen(false)}
            aria-hidden="true"
          />

          {/* ドロワーパネル本体（右からスライド） */}
          <div
            ref={drawerRef}
            role="dialog"
            aria-modal="true"
            aria-label="メニュー"
            className="fixed top-0 right-0 h-full w-72 max-w-[85vw] bg-[#0B0F19] border-l border-slate-800 shadow-2xl z-[9999] flex flex-col"
            style={{ animation: 'slideInFromRight 0.22s ease-out' }}
          >
            {/* ドロワーヘッダー（閉じるボタン） */}
            <div className="flex items-center justify-between px-4 py-3 border-b border-slate-800">
              {/* タイトル */}
              <span className="text-sm font-bold text-slate-200 flex items-center gap-2">
                {/* 亀アイコン */}
                <span className="text-lg">🐢</span>
                メニュー
              </span>
              {/* 閉じるボタン */}
              <button
                type="button"
                aria-label="メニューを閉じる"
                onClick={() => setIsOpen(false)}
                className="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-white hover:bg-slate-700/60 transition text-lg leading-none"
              >
                ✕
              </button>
            </div>

            {/* ドロワーコンテンツ（スクロール可能） */}
            <div className="flex-1 overflow-y-auto px-4 py-4 space-y-5">
              {children}
            </div>
          </div>
        </>,
        // body 直下にportalとして描画
        document.body
      )}
    </>
  );
}
</file>

